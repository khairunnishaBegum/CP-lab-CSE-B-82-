#include <stdio.h>

int main() {
    int A, B;
    scanf("%d %d", &A, &B);

    int a = A, b = B;
    int x1 = 1, y1 = 0;
    int x2 = 0, y2 = 1;

    while (b != 0) {
        int q = a / b;

        int temp;

        temp = a;
        a = b;
        b = temp - q * b;

        temp = x1;
        x1 = x2;
        x2 = temp - q * x2;

        temp = y1;
        y1 = y2;
        y2 = temp - q * y2;
    }

    printf("%d %d %d", x1, y1, a);

    return 0;
}
