from collections import deque
n, m = map(int, input().split())

grid = []
q = deque()
fresh = 0
for i in range(n):
    row = list(map(int, input().split()))
    grid.append(row)
    for j in range(m):
        if row[j] == 2:
            q.append((i, j))
        elif row[j] == 1:
            fresh += 1
time = 0
while q and fresh > 0:
    size = len(q)
    for _ in range(size):
        i, j = q.popleft()
        if i > 0 and grid[i-1][j] == 1:
            grid[i-1][j] = 2
            fresh -= 1
            q.append((i-1, j))
            
        if i < n-1 and grid[i+1][j] == 1:
            grid[i+1][j] = 2
            fresh -= 1
            q.append((i+1, j))

        if j > 0 and grid[i][j-1] == 1:
            grid[i][j-1] = 2
            fresh -= 1
            q.append((i, j-1))

        if j < m-1 and grid[i][j+1] == 1:
            grid[i][j+1] = 2
            fresh -= 1
            q.append((i, j+1))

    time += 1

if fresh == 0:
    print(time)
else:
    print(-1)
