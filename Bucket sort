#include <stdio.h>
int main() {
    int n;
    scanf("%d", &n);
    double a[n];
    for (int i = 0; i < n; i++) {
        scanf("%lf", &a[i]);
    }
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (a[i] > a[j]) {
                double temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }
        }
    }
    for (int i = 0; i < n; i++) {
        if (a[i] == (int)a[i])
            printf("%d", (int)a[i]);
        else
            printf("%.2f", a[i]);

        if (i < n - 1)
            printf(" ");
    }

    return 0;
}
