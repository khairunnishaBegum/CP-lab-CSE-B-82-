#include <stdio.h>
#include <stdlib.h>
int n, a[30];
int total, ans = 1000000;

void find(int index, int count, int sum) {
    if (count > n / 2)
        return;
    if (index == n) {
        if (count == n / 2 || (n % 2 == 1 && count == n / 2 + 1)) {
            int diff = abs(total - 2 * sum);

            if (diff < ans)
                ans = diff;
        }
        return;
    }
    find(index + 1, count + 1, sum + a[index]);
    find(index + 1, count, sum);
}
int main() {
    scanf("%d", &n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
        total += a[i];
    }
    find(0, 0, 0);
    printf("%d", ans);
    return 0;
}
