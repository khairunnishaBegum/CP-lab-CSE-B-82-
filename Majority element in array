#include <stdio.h>
int main()
{
    int n;
    scanf("%d", &n);
    int arr[n];
    for(int i = 0; i < n; i++)
    {
     scanf("%d", &arr[i]);
    }
    int majority = arr[0];
    int count = 1;
    for(int i = 1; i < n; i++)
    {
     if(arr[i] == majority){
       count++;
     }
     else{
      count--;
      if(count == 0){
        majority = arr[i];
        count = 1;
      }
    }
    }
    int freq = 0;
    for(int i = 0; i < n; i++)
    {
     if(arr[i] == majority)
        {
         freq++;
        }
    }
    if(freq > n / 2){
     printf("%d\n", majority);
    }
    else{
     printf("-1\n");
    }
    return 0;
}
        
