#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main(){
    unsigned long long n;
    int count = 0;
    if (scanf("%d", &n) != 1) {
        return 0;
    }
    while (n > 0) {
        n = n & (n - 1); 
        count++;        
    }
    printf("%d\n", count);
    return 0;
}

