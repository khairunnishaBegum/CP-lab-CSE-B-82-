#include <stdio.h>
#include <string.h>
int main()
{
    char s[100001];
    scanf("%s", s);
    int seen = 0;
    int duplicate = 0;
    int found = 0;
    for (int i = 0; i < strlen(s); i++)
    {
        int pos = s[i] - 'a';
        int bit = 1 << pos;
        if (seen & bit){
          if (!(duplicate & bit)){
            printf("%c ", s[i]);
            duplicate = duplicate | bit;
            found = 1;
            }
        }
        else{
            seen = seen | bit;
        }
    }
    if (found == 0)
    {
        printf("No duplicates");
    }
    return 0;
}
