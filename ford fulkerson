from collections import deque

V, E = map(int, input().split())

graph = [[0] * V for _ in range(V)]

for i in range(E):
    u, v, c = map(int, input().split())
    graph[u][v] = c
def bfs(source, sink, parent):
    visited = [False] * V
    queue = deque([source])
    visited[source] = True
    parent[source] = -1
    while queue:
        u = queue.popleft()

        for v in range(V):
            if graph[u][v] > 0 and not visited[v]:
                queue.append(v)
                parent[v] = u
                visited[v] = True

                if v == sink:
                    return True

    return False
max_flow = 0
source = 0
sink = V - 1
parent = [-1] * V
while bfs(source, sink, parent):
    flow = float('inf')
    v = sink
    while v != source:
        u = parent[v]
        flow = min(flow, graph[u][v])
        v = u

    v = sink
    while v != source:
        u = parent[v]

        graph[u][v] -= flow
        graph[v][u] += flow

        v = u

    max_flow += flow

print(max_flow)
